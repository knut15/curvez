{
  "name": "curvez-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:handwork": "pnpm --filter handwork dev",
    "dev:scopulus-ui": "pnpm --filter scopulus-ui-site dev",
    "dev:city-presets": "pnpm --filter city-presets dev",
    "dev:storybook": "pnpm --filter @scopulus/ui storybook",
    "lint": "eslint . && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@curvez/eslint-config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
